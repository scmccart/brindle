[
  {
    "label": "Debug brindle (CodeLLDB)",
    "adapter": "CodeLLDB",
    "request": "launch",
    "build": {
      "command": "cargo",
      "args": ["build"]
    },
    "program": "$ZED_WORKTREE_ROOT/target/debug/brindle",
    "cwd": "$ZED_WORKTREE_ROOT",
    "sourceLanguages": ["rust"],
    "env": {
      "RUST_BACKTRACE": "1",
      "RUST_LOG": "brindle=debug,warn"
    }
  },
  {
    "label": "Debug brindle (GDB)",
    "adapter": "GDB",
    "request": "launch",
    "build": {
      "command": "cargo",
      "args": ["build"]
    },
    "program": "$ZED_WORKTREE_ROOT/target/debug/brindle",
    "cwd": "$ZED_WORKTREE_ROOT",
    "env": {
      "RUST_BACKTRACE": "1",
      "RUST_LOG": "brindle=debug,warn"
    }
  }
]
