#!/bin/sh
# Checks .github/workflows/ with actionlint (which runs shellcheck on each
# `run:` script), configured by .github/actionlint.yaml, and with shellcheck
# the installer scripts, since a release's install.sh (scripts/get.sh) runs
# on its own through `curl | sh`, and scripts/e2e-bundle, which the e2e jobs
# run:
#
#   scripts/lint-workflows            # every workflow
#   scripts/lint-workflows FILE...    # these workflow files
#
# It runs actionlint's Docker image, which bundles shellcheck, at the version
# pinned here (moved by hand), so it needs a Docker daemon.
set -eu

ACTIONLINT_VERSION=1.7.12

cd "$(dirname "$0")/.."
if ! command -v docker >/dev/null 2>&1; then
    echo "lint-workflows: docker is missing" >&2
    exit 1
fi
# Git Bash on Windows would turn /repo into a Windows path.
export MSYS_NO_PATHCONV=1
image=rhysd/actionlint:$ACTIONLINT_VERSION
docker run --rm -v "$(pwd):/repo" -w /repo --entrypoint shellcheck "$image" \
    scripts/get.sh scripts/install.sh scripts/uninstall.sh scripts/e2e-bundle
exec docker run --rm -v "$(pwd):/repo" -w /repo "$image" -no-color "$@"
